<?xml version="1.0" encoding="UTF-8"?>
<definitions name="OrderProcess" targetNamespace="http://j2ee.netbeans.org/wsdl/OrdersProcessBpel/src/OrderProcess"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://j2ee.netbeans.org/wsdl/OrdersProcessBpel/src/OrderProcess" xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype">
    <types>
    <xsd:schema targetNamespace="http://j2ee.netbeans.org/wsdl/OrdersProcessBpel/src/OrderProcess">
      <xsd:element name="NotifyInventoryChange">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="orderId" type="xsd:long"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
    </types>
    <message name="OrderProcessOperationRequest">
        <part name="orderID" type="xsd:long"/>
        <part name="customerID" type="xsd:long"/>
    </message>
    <message name="OrderProcessOperationResponse">
        <part name="billId" type="xsd:string"/>
        <part name="shipNumber" type="xsd:string"/>
        <part name="description" type="xsd:string"/>
        <part name="totalAmount" type="xsd:double"/>
    </message>

    <message name="NotifyInventoryChangeRequest">
      <part name="parameters" element="tns:NotifyInventoryChange"/>
    </message>
    
    <portType name="OrderProcessPortType">
        <operation name="OrderProcessOperation">
            <input name="input1" message="tns:OrderProcessOperationRequest"/>
            <output name="output1" message="tns:OrderProcessOperationResponse"/>
        </operation>
        <operation name="NotifyInventoryChange">
            <input name="input2" message="tns:NotifyInventoryChangeRequest"/>
        </operation>
    </portType>

    <plnk:partnerLinkType name="OrderProcess">
        <!-- A partner link type is automatically generated when a new port type is added. Partner link types are used by BPEL processes. 
In a BPEL process, a partner link represents the interaction between the BPEL process and a partner service. Each partner link is associated with a partner link type.
A partner link type characterizes the conversational relationship between two services. The partner link type can have one or two roles.-->
        <plnk:role name="OrderProcessPortTypeRole" portType="tns:OrderProcessPortType"/>
    </plnk:partnerLinkType>
</definitions>
