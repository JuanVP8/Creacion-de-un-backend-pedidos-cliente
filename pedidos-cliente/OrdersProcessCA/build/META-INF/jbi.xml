<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<jbi xmlns="http://java.sun.com/xml/ns/jbi" xmlns:ns1="OrdersProcessCA" xmlns:ns2="http://enterprise.netbeans.org/bpel/OrdersProcessBpel/ordersProcessBpel" xmlns:ns3="http://j2ee.netbeans.org/wsdl/OrdersProcessBpel/src/OrderProcess" xmlns:ns4="http://rs.udc.es/orders" xmlns:ns5="http://rs.udc.es/inventory" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.0" xsi:schemaLocation="http://java.sun.com/xml/ns/jbi ./jbi.xsd">
    <service-assembly>
        <identification>
            <name>OrdersProcessCA</name>
            <description>Represents the Service Assembly of OrdersProcessCA</description>
        </identification>
        <service-unit>
            <identification>
                <name>OrdersProcessCA-OrdersProcessBpel</name>
                <description>Represents this Service Unit</description>
            </identification>
            <target>
                <artifacts-zip>OrdersProcessBpel.jar</artifacts-zip>
                <component-name>sun-bpel-engine</component-name>
            </target>
        </service-unit>
        <service-unit>
            <identification>
                <name>OrdersProcessCA-sun-http-binding</name>
                <description>Represents this Service Unit</description>
            </identification>
            <target>
                <artifacts-zip>sun-http-binding.jar</artifacts-zip>
                <component-name>sun-http-binding</component-name>
            </target>
        </service-unit>
        <connections>
            <connection>
                <consumer endpoint-name="OrderProcess" service-name="ns1:OrdersProcessCAService1"/>
                <provider endpoint-name="OrderProcessPortTypeRole_myRole" service-name="ns2:ClientPL"/>
            </connection>
            <connection>
                <consumer endpoint-name="OrderProviderRole_partnerRole" service-name="ns2:OrderPL"/>
                <provider endpoint-name="OrderService" service-name="ns1:OrdersProcessCAService2"/>
            </connection>
            <connection>
                <consumer endpoint-name="InventoryProviderRole_partnerRole" service-name="ns2:InventoryPL"/>
                <provider endpoint-name="InventoryService" service-name="ns1:OrdersProcessCAService3"/>
            </connection>
        </connections>
        <route-types xmlns="http://www.open-esb.net/xml/ns/jbi">
            <source endpoint-name="OrderProcess" mode="local" routing-rule="default" service-name="ns1:OrdersProcessCAService1">direct</source>
            <source endpoint-name="OrderProviderRole_partnerRole" mode="local" routing-rule="default" service-name="ns2:OrderPL">direct</source>
            <source endpoint-name="InventoryProviderRole_partnerRole" mode="local" routing-rule="default" service-name="ns2:InventoryPL">direct</source>
        </route-types>
        <interface-mapping xmlns="http://www.open-esb.net/xml/ns/jbi">
            <implementation>
                <by-provider endpoint-name="OrderProcessPortTypeRole_myRole" service-name="ns2:ClientPL"/>
                <interface name="ns3:OrderProcessPortType"/>
            </implementation>
            <implementation>
                <by-provider endpoint-name="OrderService" service-name="ns1:OrdersProcessCAService2"/>
                <interface name="ns4:OrderProvider"/>
            </implementation>
            <implementation>
                <by-provider endpoint-name="InventoryService" service-name="ns1:OrdersProcessCAService3"/>
                <interface name="ns5:InventoryProvider"/>
            </implementation>
        </interface-mapping>
    </service-assembly>
</jbi>
