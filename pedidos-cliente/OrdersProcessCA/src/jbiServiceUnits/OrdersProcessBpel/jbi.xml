            <ns6:process-name>ordersProcessBpel</ns6:process-name>
            <ns6:file-path>ordersProcessBpel.bpel</ns6:file-path>
        </consumes>
        <consumes endpoint-name="ShippingProviderRole_partnerRole" interface-name="ns4:ShippingProvider" service-name="ns0:ShippingPL">
            <ns6:display-name>ShippingPL</ns6:display-name>
            <ns6:process-name>ordersProcessBpel</ns6:process-name>
            <ns6:file-path>ordersProcessBpel.bpel</ns6:file-path>
        </consumes>
    </services>
</jbi>
