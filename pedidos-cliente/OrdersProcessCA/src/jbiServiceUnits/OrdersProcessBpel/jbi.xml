<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<jbi xmlns="http://java.sun.com/xml/ns/jbi" xmlns:ns0="http://enterprise.netbeans.org/bpel/OrdersProcessBpel/ordersProcessBpel" xmlns:ns1="http://rs.udc.es/orders" xmlns:ns2="http://rs.udc.es/inventory" xmlns:ns3="http://rs.udc.es/billing" xmlns:ns4="http://rs.udc.es/shipping" xmlns:ns5="http://j2ee.netbeans.org/wsdl/OrdersProcessBpel/src/OrderProcess" xmlns:ns6="http://www.sun.com/jbi/descriptor/service-unit" version="1.0">
    <services binding-component="false">
        <provides endpoint-name="OrderProcessPortTypeRole_myRole" interface-name="ns5:OrderProcessPortType" service-name="ns0:ClientPL">
            <ns6:display-name>ClientPL</ns6:display-name>
            <ns6:process-name>ordersProcessBpel</ns6:process-name>
            <ns6:file-path>ordersProcessBpel.bpel</ns6:file-path>
        </provides>
        <consumes endpoint-name="OrderProviderRole_partnerRole" interface-name="ns1:OrderProvider" service-name="ns0:OrderPL">
            <ns6:display-name>OrderPL</ns6:display-name>
            <ns6:process-name>ordersProcessBpel</ns6:process-name>
            <ns6:file-path>ordersProcessBpel.bpel</ns6:file-path>
        </consumes>
        <consumes endpoint-name="InventoryProviderRole_partnerRole" interface-name="ns2:InventoryProvider" service-name="ns0:InventoryPL">
